{
  // ===========================================================================
  // motion_profile.json ——【状态机版 school_flow.py 专用】动作组 + 里程 + 工位
  // ---------------------------------------------------------------------------
  // ⚠️ 2026-09-16 起主程序改成**流水账版** `school_main.py`：参数直接写在 Python 里
  //    （见 school_main.py 顶部「现场参数区」），**不再读本文件**。
  //    保留本文件是为了：① 老流程可复现；② 需要"把动作组整组下发给下位机"时仍可用
  //    （`python3 school_flow.py ...`）。
  // ---------------------------------------------------------------------------
  // ★怎么生效：改完直接重跑主程序。school_flow.py 在 M0 会把它"下发"给 STM32——
  //     参数走 0x20、动作组步骤走 0x21，关键参数还会用 0x22 读回校验；
  //     校验不一致 → 拒绝发车（见 校赛/lower_api.py 的 sync_profile）。
  //     所以：改这里 = 改下位机行为，不用重烧固件。
  // ★单位：cm / 度 / RPM(转速) / 脉冲（3200 脉冲 = 电机 1 圈，16 细分）
  // ★改完先干跑验证：python3 -u school_flow.py --dry-run --code 123+321
  // ★本文件允许 // 和 /* */ 注释（school_config.load_profile 会自动剥掉再解析）
  // ===========================================================================

  "params": {
    // ---- 底盘 ----
    "chassis_vel": 8,            // 底盘平移/前进速度档（越大越快；现场先 8，飘就降到 6）
    "chassis_acc": 6,            // 加速档（AVR446 的 accel）
    "chassis_dec": 3,            // 减速档（比 acc 小 = 刹车比起步缓，防点头/丢步）

    // ---- TTL 闭环电机通用 ----
    "ttl_default_vel": 40,       // 动作组里没写速度时的默认 RPM
    "axes_home_speed": 40,       // 回 Home 时的速度 RPM

    // ---- 夹爪 / 机械臂（脉冲 = 行程，全部现场标定）----
    "grip_close_angle": 82,   // ★夹爪是舵机: 闭合角度(度), 不是脉冲
    "grip_open_angle": 50,    // ★夹爪是舵机: 张开角度(度)
    "base_left90_pulses": 6400,  // base 轴左转 90°：进入"左侧作业姿态"（校赛关键动作）
    "base_right90_pulses": 6400, // base 轴右转 90°：回正
    "lift_up_pulses": 4400,      // 龙门架抬升行程
    "lift_down_pulses": 4400,    // 龙门架下放行程
    "telescope_out_pulses": 3000,// 伸缩臂前伸（够到物料/靶心）
    "telescope_in_pulses": 3000  // 伸缩臂收回
  },

  // ===========================================================================
  // groups —— 动作组（下位机只做解释器，按这里的步骤逐条执行）
  //
  // 步骤格式（三种，任选）：
  //   ["axis", 轴号, 方向, 脉冲, 速度RPM]   ← 走闭环电机；★执行完会"等到位"再走下一步
  //   ["grip_close", 0,0,0,0]              ← 夹爪闭合（内部会延时 300ms 稳一下）
  //   ["grip_open",  0,0,0,0]              ← 夹爪张开
  //   ["wait",       0,0,毫秒,0]           ← 纯等待
  // 轴号：1=伸缩滑台   2/3=龙门架（镜像互反，写 2 即可）   4=base 轴
  // 方向：0=正转   1=反转
  // ===========================================================================
  "groups": {
    // 上电/收臂归位：伸缩收回 → base 回正 → 夹爪闭合（保持夹持姿态）
    "HOME": [
      ["axis", 1, 1, 3000, 40],
      ["axis", 4, 1, 6400, 40],
      ["grip_close", 0, 0, 0, 0]
    ],

    // base 左转 90°：车左侧朝向料区/加工区，进入作业姿态（进原料区、进加工区各调一次）
    "BASE_TO_LEFT": [
      ["axis", 4, 0, 6400, 40]
    ],

    // base 回正：作业结束收臂用
    "BASE_TO_HOME": [
      ["axis", 4, 1, 6400, 40]
    ],

    // 取料下探 + 夹（G1/G2/G3 瞄准收敛后调用）
    "PICK_DOWN": [
      ["axis", 1, 0, 3000, 30],       // 慢速前伸，避免撞料
      ["grip_close", 0, 0, 0, 0]
    ],

    // 取料抬起（夹住之后把物料提起来，别蹭到地面/台面）
    "PICK_UP": [
      ["axis", 1, 1, 3000, 40]
    ],

    // 放料：下放 → 松爪（P1/P2/P3 回放到靶心后调用）
    "PLACE_DOWN": [
      ["axis", 1, 0, 3000, 30],
      ["grip_open", 0, 0, 0, 0]
    ],

    // ---- 以下三组是"从车载物架夹料"的内建动作组，实际用 0x16(slot) 直接调用，
    //      这里列出是为了让你看清完整动作链；改它们不会影响 0x16 的行为 ----
    "GRAB_FROM_RACK_1": [             // 1 号位：base 正转取料
      ["axis", 4, 0, 1200, 40],
      ["axis", 1, 0, 3000, 30],
      ["grip_close", 0, 0, 0, 0],
      ["axis", 1, 1, 3000, 40]
    ],
    "GRAB_FROM_RACK_2": [             // 2 号位：base 不动
      ["axis", 1, 0, 3000, 30],
      ["grip_close", 0, 0, 0, 0],
      ["axis", 1, 1, 3000, 40]
    ],
    "GRAB_FROM_RACK_3": [             // 3 号位：base 反转取料
      ["axis", 4, 1, 1200, 40],
      ["axis", 1, 0, 3000, 30],
      ["grip_close", 0, 0, 0, 0],
      ["axis", 1, 1, 3000, 40]
    ]
  },

  // ===========================================================================
  // route —— 路线里程（cm / 度）。★全部需要现场实测标定：
  //   标定法：让车走一次，量"实际走了多少 cm"与"这里写的差多少"，按比例改数字。
  //   建议第一次都写小一点（比如目标的 80%），量出来再补。
  // ===========================================================================
  "route": {
    "leave_start_right_cm": 30,   // ① 右移出启动区（走出启动区线即可，不用太多）
    "to_scan_fwd_cm": 60,         // ② 前进到扫码位（侧装相机对准任务码）
    "to_material_fwd_cm": 80,     // ③ 前进进原料区（到"作业起点"，之后按工位坐标走）
    "material_pitch_cm": 35,      //    原料区相邻物料间距（仅参考；实际按 positions.material 走）
    "to_process_fwd_cm": 70,      // ④ 出原料区后前进
    "spin_deg": 90,               // ⑤ 原地自旋 90°（车头转向加工区通道）
    "enter_process_fwd_cm": 50,   // ⑥ 自旋后进加工区（到"作业起点"）
    "target_pitch_cm": 35,        //    加工区相邻靶位间距（仅参考；实际按 positions.target 走）
    "to_finish_fwd_cm": 60,       // ⑦ 出加工区前进
    "finish_right_cm": 120,       // ⑧ 向右长距平移进结束位（长距离，误差会累积，分段走更稳）
    "_sign_note": "方向是否装反就改 lower_api.py 的 _RIGHT_SIGN / _SPIN_SIGN，不要在这里改符号"
  },

  // ===========================================================================
  // positions —— 各工位"纵向坐标"（cm，进区作业起点 = 0，前进为正）
  //   主程序用 goto_cm() 自动决定"该前进还是后退"：
  //     · 任务码是 123+321 → 放置顺序 3→2→1 → 目标靶位是 1→2→3 → 一路向前；
  //     · 任务码是 123+123 → 放置顺序 1→2→3 → 目标靶位是 3→2→1 → 先跑到最远再退回来。
  //   ⚠️ [待确认] 物料/靶位的物理方向：若实测发现"1 号位在最远处"，把这里的数字倒过来写即可。
  // ===========================================================================
  "positions": {
    "material": { "1": 0.0, "2": 35.0, "3": 70.0 },   // 原料区：位1 最近 → 位3 最远
    "target":   { "1": 0.0, "2": 35.0, "3": 70.0 }    // 加工区：靶1 最近 → 靶3 最远
  }
}
